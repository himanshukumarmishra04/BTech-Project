# MarketPulse Environment Configuration (Example)
# Copy to .env if you wish to override defaults.

# Execution Mode: "LOCAL_DEMO" (Zero-cost offline benchmark) or "LIVE_RSS"
DEFAULT_INGESTION_MODE=LOCAL_DEMO

# Local LLM Engine (Ollama - Optional for Mode A)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.2:3b

# Application Ports
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# Deduplication Threshold (0.0 to 1.0)
DEDUPLICATION_THRESHOLD=0.80
DEDUPLICATION_TIME_WINDOW_DAYS=2
